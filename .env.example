# GEMINI_API_KEY: Optional Google Gemini API key for AI Financial Assistant RAG responses.
# Core expense management, Tesseract OCR, ML categorization, and time-series forecasting
# run completely locally without requiring paid services.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Application base URL
APP_URL="http://localhost:3000"

# Frontend API target (leave blank to use same-origin Node/Express, or set http://localhost:5000 for Flask)
VITE_API_BASE_URL=""

# ---------------------------------------------------------------------------
# Supabase Backend Configuration (Configure actual values in Settings -> Secrets)
# Use the base project URL (https://<project-id>.supabase.co), NOT /rest/v1/
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Server-only secret key from Supabase Dashboard -> Project Settings -> API Keys (never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=""
# Optional direct Supabase PostgreSQL connection string for Python/Flask SQLAlchemy
SUPABASE_DB_URL=""

# Public browser-safe Supabase client variables (optional)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Database Selection (sqlite | postgresql | mysql | mongodb)
# ---------------------------------------------------------------------------
DB_ENGINE="sqlite"

# Option 1: SQLite 3 (default live local database)
SQLITE_PATH="./data/expense_tracker.db"

# Option 2: PostgreSQL 15+ (Local pgAdmin, Supabase, Neon, Railway, Render)
DATABASE_URL=""
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="ledgeriq_db"

# Option 3: MySQL 8.0 (Local MySQL / Workbench)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="expense_tracker_db"

# Option 4: MongoDB 7.0+ (Local or MongoDB Atlas)
MONGO_URI="mongodb://127.0.0.1:27017/ledgeriq"

# Companion Python/Flask secret
FLASK_ENV="development"
FLASK_SECRET_KEY=""
